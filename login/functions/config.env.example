APP_ENV=production
APP_URL=https://yourdomain.com

# Cookie / session
COOKIE_SECURE=true
COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=true

# SMTP Configuration
# Replace with your production SMTP credentials
SMTP_HOST=smtp.yourhost.com
SMTP_PORT=465
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-secure-password-here
SMTP_FROM_ADDRESS=your-email@yourdomain.com
SMTP_FROM_NAME=Fire Detection System
SMTP_ENCRYPTION=smtps
SMTP_ALLOW_SELF_SIGNED=false

# Google reCAPTCHA
# Replace with your production reCAPTCHA keys
RECAPTCHA_SITE_KEY=your-recaptcha-site-key-here
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key-here

# Feature flags
ALLOW_HTTP_RESET=false
# In production: always fails closed regardless of this setting
RATE_LIMIT_FAIL_OPEN=false









